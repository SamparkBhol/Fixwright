{
  "name": "@fixwright/video",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Automated demo video pipeline (Playwright capture, Kokoro TTS, ffmpeg).",
  "license": "MIT",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "check": "tsc -p tsconfig.json && vitest run",
    "video:tts": "node --no-warnings tts.ts",
    "video:timeline": "node --no-warnings timeline.ts",
    "video:record": "node --no-warnings timeline.ts && node --no-warnings record.ts",
    "video:compose": "node --no-warnings compose.ts",
    "video:verify": "node --no-warnings verify.ts",
    "video:all": "bash scripts/all.sh"
  },
  "dependencies": {
    "@huggingface/transformers": "3.8.1",
    "ffmpeg-static": "5.3.0",
    "kokoro-js": "1.2.1",
    "playwright": "1.63.0"
  }
}
